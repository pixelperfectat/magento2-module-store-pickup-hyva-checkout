<?php declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\HeroiconsOutline;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use PixelPerfect\StorePickupHyvaCheckout\ViewModel\PickupLocationView;

/** @var Template $block */
/** @var ViewModelRegistry $viewModels */
/** @var Escaper $escaper */
/** @var PickupLocationView $view */

$view = $block->getData('view_model');
$location = $view->getSelectedLocation();
if ($location === null) {
    // Not a pickup quote: Hyvä's own summary, unchanged.
    echo /* @noEscape */ $block->fetchView($block->getTemplateFile('Hyva_Checkout::checkout/shipping-summary.phtml'));
    return;
}
/** @var HeroiconsOutline $heroicons */
$heroicons = $viewModels->require(HeroiconsOutline::class);
$openingHours = trim((string) $location->getOpeningHours());
$note = trim((string) $location->getNote());
$collector = $view->getCollector();
?>
<div class="pp-pickup-summary pb-6" data-pp-pickup-summary="<?= $escaper->escapeHtmlAttr($location->getCode()) ?>">
    <div class="section-title border-b border-slate-300 pb-1 mb-6">
        <h2 class="text-slate-800 text-xl font-medium flex items-center gap-2">
            <?= /* @noEscape */ $heroicons->locationMarkerHtml('w-5 h-5', 20, 20, ['aria-hidden' => 'true']) ?>
            <?= $escaper->escapeHtml(__('Pickup Location')) ?>
        </h2>
    </div>

    <address class="not-italic text-slate-700 text-sm">
        <strong class="block"><?= $escaper->escapeHtml($location->getName()) ?></strong>
        <?php foreach ($view->getAddressLines($location) as $line): ?>
            <span class="block"><?= $escaper->escapeHtml($line) ?></span>
        <?php endforeach; ?>
    </address>
    <?php if ($openingHours !== ''): ?>
        <p class="text-slate-700 text-sm mt-2"><?= /* @noEscape */ nl2br($escaper->escapeHtml($openingHours)) ?></p>
    <?php endif; ?>
    <?php if ($note !== ''): ?>
        <p class="text-slate-700 text-sm mt-2"><?= $escaper->escapeHtml($note) ?></p>
    <?php endif; ?>

    <?php if ($collector['name'] !== '' || $collector['telephone'] !== ''): ?>
        <div class="border-t border-slate-300 mt-4 pt-4 text-slate-700 text-sm">
            <strong class="block"><?= $escaper->escapeHtml(__('Collected by')) ?></strong>
            <?php if ($collector['name'] !== ''): ?>
                <span class="block"><?= $escaper->escapeHtml($collector['name']) ?></span>
            <?php endif; ?>
            <?php if ($collector['telephone'] !== ''): ?>
                <span class="block"><?= $escaper->escapeHtml($collector['telephone']) ?></span>
            <?php endif; ?>
        </div>
    <?php endif; ?>
</div>
