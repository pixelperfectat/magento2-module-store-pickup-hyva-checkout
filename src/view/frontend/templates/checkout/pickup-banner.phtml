<?php declare(strict_types=1);

use Hyva\Checkout\ViewModel\Navigation;
use Hyva\Theme\Model\ViewModelRegistry;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use PixelPerfect\StorePickupHyvaCheckout\ViewModel\PickupIcon;
use PixelPerfect\StorePickupHyvaCheckout\ViewModel\PickupLocationView;

/** @var Template $block */
/** @var ViewModelRegistry $viewModels */
/** @var Escaper $escaper */
/** @var PickupLocationView $view */

$view = $block->getData('view_model');
$location = $view->getSelectedLocation();
if ($location === null) {
    return;
}
/** @var PickupIcon $pickupIcon */
$pickupIcon = $viewModels->require(PickupIcon::class);

// The same route Hyvä's "Back to ..." button uses: the step before the active one.
/** @var Navigation $navigation */
$navigation = $viewModels->require(Navigation::class);
$navigator = $navigation->getNavigator();
$previous = $navigator->getActiveCheckout()->getStepBefore($navigator->getActiveStep());
$route = $previous ? $previous->getRoute() : 'shipping';
?>
<div class="pp-pickup-banner flex items-center gap-3 border border-slate-300 rounded p-4 mb-6" data-pp-pickup-banner x-data="initCheckoutNavigation">
    <?= /* @noEscape */ $pickupIcon->getIconHtml('w-6 h-6 shrink-0', 24, 24) ?>
    <div class="grow text-sm text-slate-700">
        <strong class="block"><?= $escaper->escapeHtml(__('In-store pickup at %1', $location->getName())) ?></strong>
        <span><?= $escaper->escapeHtml(implode(', ', $view->getAddressLines($location))) ?></span>
    </div>
    <button type="button"
            class="underline text-sm"
            data-route="<?= $escaper->escapeHtmlAttr($route) ?>"
            x-bind="buttonPrevious">
        <?= $escaper->escapeHtml(__('Change')) ?>
    </button>
</div>
