<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Module/etc/module.xsd">
    <module name="PixelPerfect_StorePickupHyvaCheckout">
        <!-- Hyva_Checkout is sequenced but only suggested in composer.json: it is a commercial package. -->
